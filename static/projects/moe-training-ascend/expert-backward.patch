+# Additional routing contract tests: Copyright 2026 verl contributors
+
+"""Routing contracts. CPU intrinsics below check wiring, not CANN correctness."""
+
+import importlib.util
+import logging
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+from torch.nn import functional as F
+from torch.utils.checkpoint import checkpoint
+
+
+@pytest.fixture
+def npu_patch(monkeypatch):
+    import sys
+
+    fake = ModuleType("torch_npu")
+    fake.observed = {}
+
+    def permute(x, ids):
+        fake.observed["ids"] = ids.detach().clone()
+        order = ids.reshape(-1).argsort(stable=True)
+        fake.observed["map"] = order
+        return x[order // ids.shape[1]], order
+
+    def unpermute(x, order, probs):
+        fake.observed["weights"] = probs
+        restored = torch.zeros_like(x).index_copy(0, order, x)
+        return (restored.reshape(*probs.shape, x.shape[-1]) * probs[..., None]).sum(1)
+
+    def gmm(xs, ws, *, group_list, group_type, group_list_type, **kwargs):
+        assert group_list_type == 1
+        fake.observed["counts"] = group_list
+        counts = group_list.long().tolist()
+        if group_type == 0:
+            return [torch.cat([part @ w for part, w in zip(xs[0].split(counts), ws[0], strict=True)])]
+        assert group_type == 2
+        return [torch.stack([x @ y for x, y in zip(xs[0].split(counts, dim=1), ws[0].split(counts), strict=True)])]
+
+    fake.npu_moe_token_permute = permute
+    fake.npu_moe_token_unpermute = unpermute
+    fake.npu_grouped_matmul = gmm
+    fake.npu_swiglu = lambda x, dim=-1: F.silu(x.chunk(2, dim)[0]) * x.chunk(2, dim)[1]
+    monkeypatch.setitem(sys.modules, "torch_npu", fake)
+    activations = ModuleType("transformers.activations")
+    activations.ACT2FN = {"silu": F.silu}
+    utils = ModuleType("transformers.utils")
+    utils.logging = SimpleNamespace(get_logger=logging.getLogger)
+    monkeypatch.setitem(sys.modules, "transformers.activations", activations)
+    monkeypatch.setitem(sys.modules, "transformers.utils", utils)
+    # CPU histc has no Long kernel. Preserve its binning semantics in the wiring model.
+    real_histc = torch.histc
+    monkeypatch.setattr(torch, "histc", lambda x, **kw: real_histc(x.double(), **kw).long())
+    path = Path(__file__).parents[2] / "verl/models/transformers/npu_patch.py"
+    spec = importlib.util.spec_from_file_location("routing_contract_patch", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module, fake
+
+
+class Expert(nn.Module):
+    def __init__(self, hidden, intermediate):
+        super().__init__()
+        self.up_proj = nn.Linear(hidden, intermediate, bias=False)
+        self.gate_proj = nn.Linear(hidden, intermediate, bias=False)
+        self.down_proj = nn.Linear(intermediate, hidden, bias=False)
+
+    def forward(self, x):
+        return self.down_proj(F.silu(self.gate_proj(x)) * self.up_proj(x))
+
+
+class Block(nn.Module):
+    def __init__(self, experts=8, k=2, norm=True):
+        super().__init__()
+        self.num_experts, self.top_k, self.norm_topk_prob = experts, k, norm
+        self.gate = nn.Linear(4, experts, bias=False)
+        self.experts = nn.ModuleList([Expert(4, 6) for _ in range(experts)])
+
+
+def reference(block, x):
+    flat = x.reshape(-1, x.shape[-1])
+    logits = block.gate(flat)
+    weights, ids = logits.float().softmax(-1).topk(block.top_k, -1)
+    if block.norm_topk_prob:
+        weights = weights / weights.sum(-1, keepdim=True)
+    weights = weights.to(x.dtype)
+    outputs = torch.stack([expert(flat) for expert in block.experts], 1)
+    selected = outputs.gather(1, ids[..., None].expand(-1, -1, x.shape[-1]))
+    return (selected * weights[..., None]).sum(1).reshape_as(x), logits, weights, ids
+
+
+@pytest.mark.parametrize("tokens,k,norm", [(0, 1, True), (8, 1, False), (8, 2, True), (8, 8, False)])
+@pytest.mark.parametrize("training,recompute", [(False, False), (True, False), (True, True)])
+@pytest.mark.parametrize("dtype", [torch.float64, torch.float32, torch.float16, torch.bfloat16])
+def test_routed_block_outputs_ids_counts_and_gradients(npu_patch, tokens, k, norm, training, recompute, dtype):
+    patch, fake = npu_patch
+    torch.manual_seed(19)
+    block = Block(k=k, norm=norm).to(dtype).train(training)
+    x = torch.randn(1, tokens, 4, dtype=dtype, requires_grad=True)
+    rtol, atol = {
+        torch.float64: (1e-10, 1e-12),
+        torch.float32: (1e-5, 1e-6),
+        torch.float16: (5e-3, 5e-3),
+        torch.bfloat16: (2e-2, 2e-2),
+    }[dtype]
+    expected, logits, weights, ids = reference(block, x)
+
+    def forward(value):
+        return patch.qwen3_moe_sparse_moe_block_forward_npu(block, value)
+
+    actual, actual_logits = checkpoint(forward, x, use_reentrant=False) if recompute else forward(x)
+    assert torch.equal(fake.observed["ids"], ids.int())
+    assert torch.equal(fake.observed["weights"], weights)
+    assert torch.equal(fake.observed["counts"], torch.bincount(ids.flatten(), minlength=8))
+    assert torch.equal(ids.flatten()[fake.observed["map"]], ids.flatten().sort().values)
+    torch.testing.assert_close(actual_logits, logits, rtol=0, atol=0)
+    torch.testing.assert_close(actual, expected, rtol=rtol, atol=atol)
+    # Include an auxiliary router term so gate connectivity cannot be hidden by output checks.
+    parameters = (x, *block.parameters())
+    ref_grads = torch.autograd.grad(expected.square().sum() + logits.square().sum() * 0.01, parameters)
+    out_grads = torch.autograd.grad(actual.square().sum() + actual_logits.square().sum() * 0.01, parameters)
+    for out, ref in zip(out_grads, ref_grads, strict=True):
+        torch.testing.assert_close(out, ref, rtol=rtol, atol=atol)
+
+
+def test_tuple_gate_consumes_given_ids_without_topk(npu_patch, monkeypatch):
+    patch, fake = npu_patch
+    block = Block().double()
+    x = torch.randn(1, 3, 4, dtype=torch.double, requires_grad=True)
+    probabilities = torch.rand(3, 8, requires_grad=True)
+    weights = torch.rand(3, 2, requires_grad=True)
+    ids = torch.tensor([[7, 0], [2, 1], [6, 5]])
+
+    class Gate(nn.Module):
+        def forward(self, x):
+            return probabilities, weights, ids
+
+    block.gate = Gate()
+    monkeypatch.setattr(torch, "topk", lambda *a, **k: pytest.fail("tuple gate was reselected"))
+    flat, out, returned = patch._qwen3_sparse_moe_routed_forward_npu(block, x)
+    assert returned is probabilities
+    assert torch.equal(fake.observed["ids"], ids.int())
+    assert torch.equal(fake.observed["weights"], weights.double())
+    torch.autograd.grad(out.sum() + returned.sum(), (x, weights, probabilities))
+    assert patch.qwen3_moe_sparse_moe_block_forward_npu(block, x).shape == x.shape
+
+
+def test_fixed_selection_gradcheck():
+    ids = torch.tensor([[0, 2], [1, 3]])
+    logits = torch.randn(2, 4, dtype=torch.double, requires_grad=True)
+
+    def selected(value):
+        probs = value.softmax(-1).gather(-1, ids)
+        return probs / probs.sum(-1, keepdim=True)
+
+    assert torch.autograd.gradcheck(selected, (logits,), atol=1e-6, rtol=1e-4)
+
+
