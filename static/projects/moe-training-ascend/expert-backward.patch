+"""Real 910B products, routing and checkpoint backward at the supported shapes."""
+
+import pytest
+import torch
+from torch.utils.checkpoint import checkpoint
+
+
+@pytest.fixture(scope="module")
+def runtime():
+    pytest.importorskip("torch_npu")
+    from verl.utils.kernel.npu.qwen3_moe import _supported_runtime
+
+    torch.npu.set_device(0)
+    if not _supported_runtime(0):
+        pytest.skip("Requires the measured 910B/CANN/torch_npu/TritonAscend runtime")
+
+
+@pytest.fixture(scope="module")
+def block(runtime):
+    from transformers.models.qwen3_moe.configuration_qwen3_moe import Qwen3MoeConfig
+    from transformers.models.qwen3_moe.modeling_qwen3_moe import Qwen3MoeSparseMoeBlock
+
+    torch.manual_seed(47)
+    config = Qwen3MoeConfig(hidden_size=2048, moe_intermediate_size=768, num_experts=128, num_experts_per_tok=8)
+    module = Qwen3MoeSparseMoeBlock(config)
+    with torch.no_grad():
+        for parameter in module.parameters():
+            parameter.normal_(0, 0.02)
+    module = module.to(device="npu", dtype=torch.bfloat16)
+    with torch.no_grad():
+        module.gate.weight.zero_()
+        module.gate.weight[:, :128].copy_(torch.eye(128, device="npu", dtype=torch.bfloat16))
+    return module
+
+
+@pytest.mark.parametrize("tokens", [128, 129, 512, 2048, 8192])
+@pytest.mark.parametrize("distribution", ["uniform", "hot", "multihot", "longtail"])
+def test_packed_block_exact_forward_and_backward(block, tokens, distribution, monkeypatch):
+    import torch_npu
+
+    from verl.models.transformers.npu_patch import _qwen3_sparse_moe_routed_forward_npu
+    from verl.utils.kernel.npu import qwen3_moe_triton
+    from verl.utils.kernel.npu.qwen3_moe import _use_packed_qwen3
+
+    generator = torch.Generator().manual_seed(47)
+    scores = torch.rand(tokens, 128, generator=generator)
+    if distribution == "hot":
+        scores[:, :8] += 2
+    elif distribution == "multihot":
+        rows = torch.arange(tokens)[:, None]
+        scores[rows, 8 * (rows % 4) + torch.arange(8)] += 2
+    elif distribution == "longtail":
+        scores *= (torch.arange(128) + 1).float().pow(-0.7)
+    hidden = torch.randn(tokens, 2048, generator=generator) * 0.02
+    hidden[:, :128] = scores
+    hidden = hidden.to(device="npu", dtype=torch.bfloat16).requires_grad_()
+    with torch.no_grad():
+        _, _, ids = block.gate(hidden)
+    assert _use_packed_qwen3(hidden, ids, block.experts)
+
+    calls = []
+    original_dx = qwen3_moe_triton.branch_group_dx
+
+    def dx(*args):
+        calls.append(True)
+        return original_dx(*args)
+
+    monkeypatch.setattr(qwen3_moe_triton, "branch_group_dx", dx)
+    routing = {}
+    permutation = torch_npu.npu_moe_token_permute
+    unpermutation = torch_npu.npu_moe_token_unpermute
+
+    def permute(value, selected):
+        output, mapping = permutation(value, selected)
+        routing["ids"] = selected.detach().clone()
+        routing["mapping"] = mapping.detach().clone()
+        routing["counts"] = torch.histc(selected.long(), bins=128, min=0, max=128)
+        return output, mapping
+
+    def unpermute(value, mapping, *, probs):
+        routing["weights"] = probs.detach().clone()
+        return unpermutation(value, mapping, probs=probs)
+
+    monkeypatch.setattr(torch_npu, "npu_moe_token_permute", permute)
+    monkeypatch.setattr(torch_npu, "npu_moe_token_unpermute", unpermute)
+    parameters = (hidden, *block.parameters())
+    results = []
+    for packed in (False, True):
+
+        def forward(value, packed=packed):
+            _, output, router = _qwen3_sparse_moe_routed_forward_npu(block, value, use_packed=packed)
+            return output, router
+
+        # Both ordinary backward and checkpoint recomputation occur in the main model.
+        output, router = checkpoint(forward, hidden, use_reentrant=False) if tokens in (128, 129) else forward(hidden)
+        gradients = torch.autograd.grad(
+            output.float().square().mean() + router.float().square().mean() * 0.01, parameters
+        )
+        results.append((output.detach(), router.detach(), dict(routing), gradients))
+    base, candidate = results
+    assert torch.count_nonzero(base[0]) > 0
+    assert torch.count_nonzero(base[3][0]) > 0
+    for index in (0, 1):
+        torch.testing.assert_close(candidate[index], base[index], rtol=0, atol=0)
+    for name in ("ids", "mapping", "counts", "weights"):
+        torch.testing.assert_close(candidate[2][name], base[2][name], rtol=0, atol=0)
+    for actual, expected in zip(candidate[3], base[3], strict=True):
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    assert calls
+
+
+def test_branch_groups_against_fp64(runtime):
+    from verl.utils.kernel.npu.qwen3_moe_triton import branch_group_dx
+
+    torch.manual_seed(47)
+    counts = torch.tensor([3, 0, 5, 1])
+    grad = (torch.randn(9, 128) * 0.02).bfloat16()
+    physical = (torch.randn(4, 128, 64) * 0.02).bfloat16()
+    reference = []
+    for g, w in zip(grad.split(counts.tolist()), physical, strict=True):
+        gate, up = g.chunk(2, dim=-1)
+        a, b = w.chunk(2, dim=0)
+        reference.append((gate.double() @ a.double()).bfloat16() + (up.double() @ b.double()).bfloat16())
+    actual = branch_group_dx(grad.npu(), physical.npu().transpose(1, 2), counts.npu())
+    actual, expected = actual.cpu(), torch.cat(reference)
+    torch.testing.assert_close(actual, expected, rtol=2e-2, atol=2e-2)
+    reference_norm = expected.double().norm()
+    assert reference_norm > 0
+    assert (actual.double() - expected.double()).norm() / reference_norm <= 2e-2
