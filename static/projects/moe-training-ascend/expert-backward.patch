+"""CPU autograd wiring; actual CANN/Triton products are verified on NPU."""
+
+import sys
+from types import ModuleType, SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+from torch.utils.checkpoint import checkpoint
+
+from verl.utils.kernel.npu import qwen3_moe
+
+pytest_plugins = ("test_npu_moe_routing_on_cpu",)
+
+
+@pytest.fixture
+def paired_products(monkeypatch, npu_patch):
+    patch, fake = npu_patch
+    kernel = ModuleType("verl.utils.kernel.npu.qwen3_moe_triton")
+    hits = []
+
+    def paired(grad, weight, counts):
+        hits.append(True)
+        parts = [
+            qwen3_moe._grouped_mm(g, w.transpose(1, 2), counts)
+            for g, w in zip(grad.chunk(2, -1), weight.chunk(2, -1), strict=True)
+        ]
+        return parts[0] + parts[1]
+
+    kernel.branch_group_dx = paired
+    monkeypatch.setitem(sys.modules, kernel.__name__, kernel)
+    return patch, fake, hits
+
+
+@pytest.mark.parametrize("paired", [False, True])
+@pytest.mark.parametrize("strided_gradient", [False, True])
+def test_parameter_layout_and_input_gradient(paired_products, paired, strided_gradient):
+    _, _, hits = paired_products
+    torch.manual_seed(47)
+    counts = torch.tensor([3, 0, 1, 2])
+    x = torch.randn(6, 4, dtype=torch.float64, requires_grad=True)
+    storage = torch.randn(4 * 6 * 4 + 17, dtype=torch.float64)
+    physical = storage[17:].view(4, 6, 4).requires_grad_()
+    weight = physical.transpose(1, 2)
+    output = qwen3_moe._PackedQwen3GMM.apply(x, weight, counts, paired)
+    expected = torch.cat([part @ w for part, w in zip(x.split(counts.tolist()), weight, strict=True)])
+    upstream = torch.randn(6, 12 if strided_gradient else 6, dtype=x.dtype)
+    upstream = upstream[:, ::2] if strided_gradient else upstream
+    actual = torch.autograd.grad(output, (x, physical), upstream)
+    reference = torch.autograd.grad(expected, (x, physical), upstream)
+    torch.testing.assert_close(output, expected, rtol=1e-10, atol=1e-12)
+    for a, b in zip(actual, reference, strict=True):
+        torch.testing.assert_close(a, b, rtol=1e-10, atol=1e-12)
+    assert actual[1].is_contiguous()
+    assert bool(hits) == (paired and not strided_gradient)
+    torch.testing.assert_close(actual[1][1], torch.zeros_like(actual[1][1]), rtol=0, atol=0)
+
+
+def test_fixed_assignment_gradcheck(paired_products):
+    torch.manual_seed(47)
+    x = torch.randn(3, 2, dtype=torch.float64, requires_grad=True)
+    physical = torch.randn(2, 4, 2, dtype=torch.float64, requires_grad=True)
+    counts = torch.tensor([1, 2])
+
+    def forward(x, physical):
+        return qwen3_moe._PackedQwen3GMM.apply(x, physical.transpose(1, 2), counts, True)
+
+    assert torch.autograd.gradcheck(forward, (x, physical), atol=1e-6, rtol=1e-4)
+
+
+@pytest.mark.parametrize("recompute", [False, True])
+def test_packed_forward_preserves_router_and_auxiliary_gradient(paired_products, monkeypatch, recompute):
+    patch, fake, hits = paired_products
+    torch.manual_seed(47)
+    ids = torch.tensor([[3, 0], [2, 1], [3, 2]])
+
+    class Gate(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.projection = nn.Linear(4, 4, bias=False, dtype=torch.float64)
+
+        def forward(self, hidden):
+            scores = self.projection(hidden).softmax(-1)
+            weights = scores.gather(1, ids)
+            return scores, weights / weights.sum(-1, keepdim=True), ids
+
+    class Experts(nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.num_experts = 4
+            self.gate_up_proj = nn.Parameter(torch.randn(4, 6, 4, dtype=torch.float64) * 0.1)
+            self.down_proj = nn.Parameter(torch.randn(4, 4, 3, dtype=torch.float64) * 0.1)
+
+    gate, experts = Gate(), Experts()
+    block = SimpleNamespace(gate=gate, experts=experts)
+    x = torch.randn(1, 3, 4, dtype=torch.float64, requires_grad=True)
+    parameters = (x, *gate.parameters(), *experts.parameters())
+    monkeypatch.setattr(torch, "topk", lambda *args, **kwargs: pytest.fail("given IDs were reselected"))
+
+    def forward(value):
+        _, output, router = patch._qwen3_sparse_moe_routed_forward_npu(block, value, use_packed=True)
+        return output, router
+
+    results = []
+    for enabled in (False, True):
+        monkeypatch.setattr(qwen3_moe, "_use_packed_qwen3", lambda *args, enabled=enabled: enabled)
+        output, router = checkpoint(forward, x, use_reentrant=False) if recompute else forward(x)
+        observations = {name: value.detach().clone() for name, value in fake.observed.items()}
+        gradients = torch.autograd.grad(output.square().sum() + router.square().sum() * 0.01, parameters)
+        results.append((output, router, observations, gradients))
+    base, candidate = results
+    for i in (0, 1):
+        torch.testing.assert_close(candidate[i], base[i], rtol=1e-10, atol=1e-12)
+    for name in ("ids", "weights", "counts", "map"):
+        torch.testing.assert_close(candidate[2][name], base[2][name], rtol=0, atol=0)
+    for a, b in zip(candidate[3], base[3], strict=True):
+        torch.testing.assert_close(a, b, rtol=1e-10, atol=1e-12)
+    assert hits
