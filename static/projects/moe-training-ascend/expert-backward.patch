+"""Packed Qwen3 expert products with separate BF16 gate/up gradient roundings."""
+
+from functools import cache
+from importlib.metadata import PackageNotFoundError, version
+
+import torch
+
+
+@cache
+def _supported_runtime(device_index):
+    import torch_npu
+
+    try:
+        versions = (
+            version("torch").split("+")[0],
+            version("torch-npu").split("+")[0],
+            version("triton-ascend"),
+            version("transformers"),
+        )
+    except PackageNotFoundError:
+        return False
+    return (
+        versions == ("2.9.0", "2.9.0.post1", "3.2.0.dev20260322", "5.5.3")
+        and torch_npu.utils.get_cann_version() == "8.5.1"
+        and "910B" in torch.npu.get_device_name(device_index)
+    )
+
+
+def _use_packed_qwen3(hidden, ids, experts):
+    """Select the measured BF16 HF layout using static metadata only."""
+    gate_up = getattr(experts, "gate_up_proj", None)
+    down = getattr(experts, "down_proj", None)
+    return (
+        hidden.device.type == "npu"
+        and hidden.dtype == torch.bfloat16
+        and hidden.shape[0] in (128, 129, 512, 2048, 8192)
+        and hidden.shape[1] == 2048
+        and hidden.is_contiguous()
+        and ids.shape == (hidden.shape[0], 8)
+        and isinstance(gate_up, torch.Tensor)
+        and isinstance(down, torch.Tensor)
+        and gate_up.shape == (128, 1536, 2048)
+        and down.shape == (128, 2048, 768)
+        and gate_up.dtype == hidden.dtype
+        and down.dtype == hidden.dtype
+        and gate_up.is_contiguous()
+        and down.is_contiguous()
+        and _supported_runtime(hidden.device.index)
+    )
+
+
+def _grouped_mm(left, right, counts, *, weight_gradient=False):
+    import torch_npu
+
+    return torch_npu.npu_grouped_matmul(
+        [left],
+        [right],
+        bias=None,
+        group_list=counts,
+        split_item=3 if weight_gradient else 2,
+        group_type=2 if weight_gradient else 0,
+        group_list_type=1,
+    )[0]
+
+
+class _PackedQwen3GMM(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, weight, counts, paired):
+        ctx.save_for_backward(x, weight, counts)
+        ctx.paired = paired
+        return _grouped_mm(x, weight, counts)
+
+    @staticmethod
+    def backward(ctx, grad):
+        x, weight, counts = ctx.saved_tensors
+        if ctx.paired:
+            if grad.is_contiguous():
+                from .qwen3_moe_triton import branch_group_dx
+
+                dx = branch_group_dx(grad, weight, counts)
+            else:
+                gate_grad, up_grad = grad.chunk(2, dim=-1)
+                gate_weight, up_weight = weight.chunk(2, dim=-1)
+                dx = _grouped_mm(gate_grad, gate_weight.transpose(1, 2), counts)
+                dx = dx + _grouped_mm(up_grad, up_weight.transpose(1, 2), counts)
+        else:
+            dx = _grouped_mm(grad, weight.transpose(1, 2), counts)
+        # Produce the HF parameter's physical [E, output, input] layout directly.
+        dw = _grouped_mm(grad.transpose(0, 1), x, counts, weight_gradient=True)
+        return dx, dw.transpose(1, 2), None, None
