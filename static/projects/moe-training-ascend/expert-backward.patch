+@pytest.mark.parametrize("tokens,k", [(1, 1), (8, 2), (32, 8)])
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16])
+def test_cann_grouping_round_trip(runtime, tokens, k, dtype):
+    _, npu = runtime
+    torch.manual_seed(20261031)
+    ids = torch.rand(tokens, 8).topk(k, dim=-1).indices.to("npu")
+    x = torch.randn(tokens, 32, dtype=dtype, device="npu", requires_grad=True)
+    weights = torch.rand(tokens, k, device="npu", dtype=dtype, requires_grad=True)
+    permuted, mapping = npu.npu_moe_token_permute(x, ids.int())
+    out = npu.npu_moe_token_unpermute(permuted, mapping, probs=weights)
+    expected = x * weights.sum(-1, keepdim=True)
+    tol = 5e-3 if dtype == torch.float16 else 2e-2
+    torch.testing.assert_close(out, expected, rtol=tol, atol=tol)
+    actual_grad = torch.autograd.grad(out.sum(), (x, weights))
+    ref_grad = torch.autograd.grad(expected.sum(), (x, weights))
+    for actual, ref in zip(actual_grad, ref_grad, strict=True):
+        torch.testing.assert_close(actual, ref, rtol=tol, atol=tol)
+
+
+@pytest.mark.parametrize("norm", [True, False])
+def test_real_qwen_block_forward_backward(runtime, norm):
+    from transformers.models.qwen3_moe.configuration_qwen3_moe import Qwen3MoeConfig
+    from transformers.models.qwen3_moe.modeling_qwen3_moe import Qwen3MoeSparseMoeBlock
+
+    patch, _ = runtime
+    torch.manual_seed(20261031)
+    config = Qwen3MoeConfig(
+        hidden_size=64, moe_intermediate_size=64, num_experts=8, num_experts_per_tok=2, norm_topk_prob=norm
+    )
+    block = Qwen3MoeSparseMoeBlock(config)
+    with torch.no_grad():
+        for parameter in block.parameters():
+            parameter.normal_(0, 0.02)
+    block = block.to(device="npu", dtype=torch.bfloat16)
+    x = torch.randn(1, 32, 64, device="npu", dtype=torch.bfloat16, requires_grad=True)
+    expected = block(x)
+    actual = patch.qwen3_moe_sparse_moe_block_forward_npu(block, x)
+    expected_out = expected[0] if isinstance(expected, tuple) else expected
+    actual_out = actual[0] if isinstance(actual, tuple) else actual
+    assert torch.count_nonzero(expected_out) > 0
+    torch.testing.assert_close(actual_out, expected_out, rtol=2e-2, atol=2e-2)
+    params = (x, *block.parameters())
+    ref_grads = torch.autograd.grad(expected_out.float().square().sum(), params, allow_unused=True)
+    out_grads = torch.autograd.grad(actual_out.float().square().sum(), params, allow_unused=True)
+    assert torch.count_nonzero(ref_grads[0]) > 0
+    for out, ref in zip(out_grads, ref_grads, strict=True):
+        if ref is None or out is None:
+            assert ref is out
+        else:
+            torch.testing.assert_close(out, ref, rtol=2e-2, atol=2e-2)
