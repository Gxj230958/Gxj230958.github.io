+@pytest.mark.parametrize("slots", [1, 2])
+@pytest.mark.parametrize("start_row, end_row", [(0, 4), (4, 7)])
+def test_direct_row_slab_preserves_padding_and_falls_back(slots, start_row, end_row):
+    # Seven rows over two four-row destinations leaves a padding row on rank 1.
+    weights = torch.arange(35, dtype=torch.int16).reshape(7, 5)
+    bias = torch.arange(3, dtype=torch.int16)
+    items = [("embedding", weights), ("bias", bias)]
+    capacity = 13  # A bucket can cut through a row and through an int16.
+    payloads = produce(items, capacity, slots)
+    runtime = QueuedRuntime()
+    receiving = Wire(runtime, payloads)
+    target = torch.full((4, 5), -1, dtype=torch.int16)
+    rows = end_row - start_row
+    view = target[:rows].reshape(-1).view(torch.uint8)
+    targets = {"embedding": (start_row * 5 * weights.element_size(), view)}
+    fallback = []
+
+    npu, empty, copy, record = runtime.install()
+    with npu, empty, copy, record:
+        bounded.bounded_broadcast_consumer(
+            metadata(items), receiving, 0, fallback.extend, capacity, slots, direct_targets=targets
+        )
+
+    assert not receiving.payloads
+    assert receiving.collective_bytes == [chunk.numel() for chunk in payloads]
+    assert torch.equal(target[:rows], weights[start_row:end_row])
+    assert (target[rows:] == -1).all()
+    assert_bytes(fallback, [("bias", bias)])
+    assert runtime.peak_bytes <= slots * capacity + bias.nbytes
